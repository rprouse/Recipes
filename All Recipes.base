filters:
  and:
    - file.ext == "md"
    - file.path.contains("/")
    - '!file.inFolder("Incoming")'
    - '!file.inFolder("Templates")'
    - '!file.inFolder("Camping")'
    - '!file.inFolder("Sports")'
    - '!file.inFolder("Reference")'
properties:
  file.folder:
    displayName: Category
  author:
    displayName: Author
  servings:
    displayName: Servings
  time:
    displayName: Time
views:
  - type: cards
    name: All Recipes
    order:
      - file.name
      - servings
      - time
      - tags
    sort:
      - property: date
        direction: DESC
    image: note.image
    imageAspectRatio: 0.5
  - type: cards
    name: Make Again
    filters:
      and:
        - file.tags.contains("make-again")
    order:
      - file.name
      - time
      - servings
      - tags
    image: note.image
    imageAspectRatio: 0.5
